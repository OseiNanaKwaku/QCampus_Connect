# QCampus Connect - Hyperledger Besu Environment Configuration
# Instructions: Copy this file to '.env' before launching:
# Windows (PowerShell): Copy-Item .env.example .env
# Linux / macOS: cp .env.example .env

# Administrative Signing Key for Besu QBFT Network
# Note: Replace with your secure development private key (NEVER commit real production keys to Git)
SYSTEM_PRIVATE_KEY=0x8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# RPC Endpoint URL exposed by the validator container
BESU_RPC_URL=http://localhost:8545

# Deployed Smart Contract Address (MessageVerifier)
CONTRACT_ADDRESS=0xa50a51c09a5c451C52BB714527E1974b686D8e77
